#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "waffle_4wd"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Xform "waffle_4wd" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physics"
    }
    append variantSets = "Physics"
)
{
    over "Physics"
    {
        over "wheel_left_front_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:maxForce = 1.8
            float physxJoint:armature = 0.00222
            float physxJoint:maxJointVelocity = 630
        }

        over "wheel_right_front_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:maxForce = 1.8
            float physxJoint:armature = 0.00222
            float physxJoint:maxJointVelocity = 630
        }

        over "wheel_left_rear_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:maxForce = 1.8
            float physxJoint:armature = 0.00222
            float physxJoint:maxJointVelocity = 630
        }

        over "wheel_right_rear_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:maxForce = 1.8
            float physxJoint:armature = 0.00222
            float physxJoint:maxJointVelocity = 630
        }

        over "joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:maxForce = 4.1
            float physxJoint:armature = 0.01
            float physxJoint:maxJointVelocity = 275.01974
        }

        over "joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:maxForce = 4.1
            float physxJoint:armature = 0.01
            float physxJoint:maxJointVelocity = 275.01974
        }

        over "joint3" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:maxForce = 4.1
            float physxJoint:armature = 0.01
            float physxJoint:maxJointVelocity = 275.01974
        }

        over "joint4" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:maxForce = 4.1
            float physxJoint:armature = 0.01
            float physxJoint:maxJointVelocity = 275.01974
        }

        over "joint5" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:maxForce = 4.1
            float physxJoint:armature = 0.01
            float physxJoint:maxJointVelocity = 275.01974
        }

        over "gripper_left_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:linear:physics:maxForce = 13
            float physxJoint:armature = 0
            float physxJoint:maxJointVelocity = 0.0408
        }

        over "gripper_right_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:linear:physics:maxForce = 13
            float physxJoint:armature = 0
            float physxJoint:maxJointVelocity = 0.0408
        }

        over "gripper_roll" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float drive:angular:physics:maxForce = 4.1
            float physxJoint:armature = 0.01
            float physxJoint:maxJointVelocity = 275.01974
        }
    }

    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </waffle_4wd/PhysicsMaterials/robot_contact> (
            bindMaterialAs = "strongerThanDescendants"
        )

        over "base_link" (
            prepend apiSchemas = ["PhysxArticulationAPI"]
        )
        {
            bool physxArticulation:enabledSelfCollisions = 1

            over "link2" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
            )
            {
                rel physics:filteredPairs = [
                    </waffle_4wd/Geometry/base_link/link2/link3>,
                    </waffle_4wd/Geometry/base_link/link2/link3/link4>,
                    </waffle_4wd/Geometry/base_link/link2/link3/link4/link5>,
                    </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link>,
                    </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_motor_link>,
                    </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_left_link>,
                    </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_right_link>,
                ]

                over "link3" (
                    prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
                )
                {
                    rel physics:filteredPairs = [
                        </waffle_4wd/Geometry/base_link/link2/link3/link4>,
                        </waffle_4wd/Geometry/base_link/link2/link3/link4/link5>,
                        </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link>,
                        </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_motor_link>,
                        </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_left_link>,
                        </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_right_link>,
                    ]

                    over "link4" (
                        prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
                    )
                    {
                        rel physics:filteredPairs = [
                            </waffle_4wd/Geometry/base_link/link2/link3/link4/link5>,
                            </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link>,
                            </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_motor_link>,
                            </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_left_link>,
                            </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_right_link>,
                        ]

                        over "link5" (
                            prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
                        )
                        {
                            rel physics:filteredPairs = [
                                </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link>,
                                </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_motor_link>,
                                </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_left_link>,
                                </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_right_link>,
                            ]

                            over "gripper_roll_link" (
                                prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
                            )
                            {
                                rel physics:filteredPairs = [
                                    </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_motor_link>,
                                    </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_left_link>,
                                    </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_right_link>,
                                ]

                                over "gripper_motor_link" (
                                    prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
                                )
                                {
                                    rel physics:filteredPairs = [
                                        </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_left_link>,
                                        </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_right_link>,
                                    ]
                                }

                                over "gripper_left_link" (
                                    prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
                                )
                                {
                                    rel physics:filteredPairs = </waffle_4wd/Geometry/base_link/link2/link3/link4/link5/gripper_roll_link/gripper_right_link>
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    def "PhysicsMaterials"
    {
        def Material "robot_contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1
            float physics:restitution = 0
            float physics:staticFriction = 1
        }
    }
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
}

