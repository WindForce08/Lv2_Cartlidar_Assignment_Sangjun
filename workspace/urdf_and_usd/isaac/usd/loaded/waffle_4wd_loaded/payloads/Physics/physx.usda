#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "waffle_4wd"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "waffle_4wd"
{
    over "Physics"
    {
        over "wheel_left_front_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wheel_right_front_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wheel_left_rear_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wheel_right_rear_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "joint1" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "joint2" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "joint3" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "joint4" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "joint5" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "gripper_left_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "gripper_right_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "gripper_roll" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

