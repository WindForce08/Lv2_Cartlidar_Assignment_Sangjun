#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "waffle_4wd"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "waffle_4wd" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "wheel_left_front_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wheel_right_front_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wheel_left_rear_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wheel_right_rear_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint1" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint2" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint3" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint4" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint5" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_left_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_right_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_roll" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "wheel_left_front_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "wheel_right_front_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "wheel_left_rear_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "wheel_right_rear_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "link2" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "link3" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "link4" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "link5" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "gripper_roll_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "gripper_left_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }

                                over "gripper_right_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }

                                over "gripper_motor_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

