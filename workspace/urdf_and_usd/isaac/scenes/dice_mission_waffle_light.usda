#usda 1.0
(
    doc = """주사위 경기장 + waffle_4wd (light). 자동 생성: isaac/tools/make_maze_scene.py (start_zone, --yaw 3.14159). 직접 고치지 말 것.
로봇: 출발 구역 (start_zone) 가운데 (차체 외곽 기준, 가장자리까지 127 mm 남음), 방향 180 deg, 팔 = drive 자세."""
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [
        @./dice_mission.usda@
    ]
)

over "World"
{
    def PhysicsScene "physicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
    }

    def Xform "waffle_4wd" (
        prepend references = @../usd/light/waffle_4wd_light/waffle_4wd_light.usda@
    )
    {
        double3 xformOp:translate = (0.693650, 0.950000, 0.009750)
        quatd xformOp:orient = (0.000000000, 0, 0, 1.000000000)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        over "Physics"
        {
            over "joint1" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float drive:angular:physics:targetPosition = 0
                float state:angular:physics:position = 0
            }
            over "joint2" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float drive:angular:physics:targetPosition = -77.3493
                float state:angular:physics:position = -77.3493
            }
            over "joint3" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float drive:angular:physics:targetPosition = 65.873
                float state:angular:physics:position = 65.873
            }
            over "joint4" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float drive:angular:physics:targetPosition = 46.3752
                float state:angular:physics:position = 46.3752
            }
            over "joint5" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float drive:angular:physics:targetPosition = 0
                float state:angular:physics:position = 0
            }
            over "gripper_roll" (
                prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
            )
            {
                float drive:angular:physics:targetPosition = 0
                float state:angular:physics:position = 0
            }
            over "gripper_left_joint" (
                prepend apiSchemas = ["PhysicsJointStateAPI:linear"]
            )
            {
                float drive:linear:physics:targetPosition = 0
                float state:linear:physics:position = 0
            }
            over "gripper_right_joint" (
                prepend apiSchemas = ["PhysicsJointStateAPI:linear"]
            )
            {
                float drive:linear:physics:targetPosition = 0
                float state:linear:physics:position = 0
            }
        }
    }
}
