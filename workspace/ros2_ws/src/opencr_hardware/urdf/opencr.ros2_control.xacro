<?xml version="1.0"?>
<!-- OpenCRHardware ros2_control 블록 (Firmware 팀). 형상 없음 - 로봇 URDF (차체 2안, 대기) 가 이 매크로를 include 해서 쓴다.
     바퀴 칸 0~3 = 주행 펌웨어 config.h 의 WHEEL_IDS 순서 (왼쪽 앞 · 왼쪽 뒤 · 오른쪽 앞 · 오른쪽 뒤).
     팔 칸 0~5 = 팔 펌웨어 ARM_IDS 순서 (joint1~4 · wrist_roll_joint · gripper_motor_joint).
     2026-10-27: 1안 차체 (cartridar_01) 폐기 → 로봇 URDF · CAD 가져오기 도구를 지움. 관절 이름은 2안 URDF 이름에 맞춰 다시 볼 것 ★ -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="opencr_wheel" params="name slot">
    <joint name="${name}">
      <param name="role">wheel</param>
      <param name="slot">${slot}</param>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="opencr_arm_joint" params="name slot lower upper">
    <joint name="${name}">
      <param name="role">arm</param>
      <param name="slot">${slot}</param>
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <!-- 두 OpenCR의 순서는 고정하지 않고 STATE.role로 역할을 판별한다. -->
  <!-- 바퀴 칸 (왼앞 0 · 왼뒤 1 · 오른앞 2 · 오른뒤 3) 은 주행 펌웨어 config.h WHEEL_IDS · WHEEL_DIR 와,
       팔 칸 0~5 는 팔 펌웨어 ARM_IDS {11, 12, 13, 16, 14, 15} 순서와 같다.
       바퀴 이름 · 개수는 차체 2안 확정 뒤 그 URDF 에 맞춤 ★ (지금 이름 wheel_fl/rl/fr/rr_joint 는 폐기된 1안 것) -->
  <xacro:macro name="opencr_ros2_control" params="name:=OpenCRSystem ports:=/dev/ttyACM0,/dev/ttyACM1 joy_required:=true">
    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>opencr_hardware/OpenCRHardware</plugin>
        <param name="ports">${ports}</param>
        <param name="comm_timeout_s">0.5</param>
        <param name="first_state_timeout_s">2.0</param>
        <!-- 잠금식 E-stop: /joy heartbeat · 버튼 (조이스틱 모델에 맞춰 번호 확인 ★) -->
        <param name="joy_required">${joy_required}</param>
        <param name="joy_timeout_s">0.5</param>
        <param name="estop_button">6</param>
        <param name="reset_button">7</param>
        <param name="battery_warn_v">11.1</param>
        <param name="battery_error_v">10.5</param>
      </hardware>

      <xacro:opencr_wheel name="wheel_fl_joint" slot="0"/>
      <xacro:opencr_wheel name="wheel_rl_joint" slot="1"/>
      <xacro:opencr_wheel name="wheel_fr_joint" slot="2"/>
      <xacro:opencr_wheel name="wheel_rr_joint" slot="3"/>

      <!-- 팔 관절 한계 (rad): 호스트가 명령을 이 범위로 자른다. 펌웨어 config.h ARM_MIN/MAX_RAD 안이어야 하고
           (펌웨어는 범위 밖 CMD 를 통째로 거부 - test_robot_description 이 확인), 로봇 URDF 가 오면 그 <limit> 안이기도 해야 함.
           2026-10-27 (arm_bench 실물): 펌웨어 범위를 실물에 맞춰 넓힘 (대기 자세 포함 · J1 ±180°) → 여기도 펌웨어 범위 그대로 -->
      <xacro:opencr_arm_joint name="joint1"           slot="0" lower="-3.14159" upper="3.14159"/>
      <xacro:opencr_arm_joint name="joint2"           slot="1" lower="-2.14"    upper="1.6"/>
      <xacro:opencr_arm_joint name="joint3"           slot="2" lower="-1.6"     upper="1.6"/>
      <xacro:opencr_arm_joint name="joint4"           slot="3" lower="-1.92"    upper="2.0"/>
      <xacro:opencr_arm_joint name="wrist_roll_joint" slot="4" lower="-2.8"     upper="2.8"/>
      <!-- 6 번째 칸 = 그리퍼 개폐 모터 (ID 15, 모터 각 rad). 로봇 URDF 에 가상 관절 (빈 링크) 로 둬야 함 (hardware_interface 는 URDF 에 없는 관절을 거부).
           칸이 비면 호스트가 0 을 보내므로 반드시 둔다 — 명령하는 컨트롤러가 없으면 켤 때 위치를 유지.
           범위 = 펌웨어 config.h 6 번째 칸. gripper_controller 가 이 관절 (모터 각 rad) 을 직접 명령한다.
           손가락 (gripper_left/right_joint, m) 과의 변환은 미정 ★
           2026-10-27 다시 결합해 0/4095 경계를 지나지 않음 (열림 1550 · 닫힘 2650 tick, 닫을수록 증가). 막힘 보호는 펌웨어 GripGuard -->
      <xacro:opencr_arm_joint name="gripper_motor_joint" slot="5" lower="-0.7946" upper="0.9541"/>

      <sensor name="imu">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>
    </ros2_control>
  </xacro:macro>
</robot>
