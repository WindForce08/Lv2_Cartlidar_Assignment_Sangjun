<?xml version="1.0"?>
<!-- 퍽 운반 로봇 URDF (Firmware 팀) — TF 트리 · ros2_control.
     몸체 · 관절 · 센서 좌표 · 충돌 · 관성은 CAD 에서 자동 생성한 cartridar_01.urdf 를 그대로 쓴다 (2026-10-26 사용자 1안:
       4륜 · 바퀴 직결 · RealSense 브래킷 v2 10° · 팔 한계 = 보관함 계획 J1 ±180° · J4 위 124°).
       FreeCAD TeamRobot/URDF: robot_params.json 수정 → ./run_urdf.sh cartridar_01 → scripts/import_cad_urdf.py 로 가져옴
       (겉모양 뺌, D435 이름 d435_front/rear → top_camera_front/rear).
       그 파일은 직접 고치지 않는다.
     이 파일은 그 위에 ros2_control (opencr.ros2_control.xacro) 과 다른 노드가 쓰는 별칭 좌표만 얹는다.
     이름 (CAD): 바퀴 wheel_fl/rl/fr/rr_joint · 팔 joint1~4 · wrist_roll_joint · 손가락 gripper_left/right_joint ·
       센서 top_camera_front/rear_link (+ _optical_frame, D435 깊이 원점 = realsense <camera_name>_link) · lds03_front/rear_link (뒤집어 장착, roll π) · tfmini_link · gripper_camera_link ·
       imu_link (아래 OpenCR = 주행 보드) · end_effector_link · base_footprint -->
<robot name="cartridar_01" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="ports" default="/dev/ttyACM0,/dev/ttyACM1"/>
  <xacro:arg name="joy_required" default="true"/>

  <xacro:include filename="$(find opencr_hardware)/urdf/cartridar_01.urdf"/>
  <xacro:include filename="$(find opencr_hardware)/urdf/opencr.ros2_control.xacro"/>

  <!-- 별칭: manipulator_node (Controller 팀) 의 팔 기준 좌표. joint1 축 위, link1 (맨 아래 서보) 높이 — joint2 는 이보다 0.0595 m 위 -->
  <link name="arm_base_link"/>
  <joint name="arm_base_link_joint" type="fixed">
    <parent link="link1"/>
    <child link="arm_base_link"/>
    <origin xyz="0.012 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 그리퍼 개폐 모터 (팔 6 번째 칸, ID 15) 의 각도 [rad]. 손가락 (gripper_left/right_joint, m) 과의 변환이 정해지기 전까지
       ros2_control 이 이 관절로 다룬다 (hardware_interface 는 URDF 에 없는 관절을 거부). 빈 링크라 다른 좌표에 영향 없음 -->
  <link name="gripper_motor_link"/>
  <joint name="gripper_motor_joint" type="revolute">
    <parent link="gripper_link"/>
    <child link="gripper_motor_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.83" upper="1.27" effort="4.1" velocity="4.8"/>
  </joint>

  <xacro:opencr_ros2_control ports="$(arg ports)" joy_required="$(arg joy_required)"/>
</robot>
